<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Deliberately NOT in MaturinLogo.slnx: this is a documentation tool, not part of the app. Keeping
    it out of the solution means dotnet build and dotnet publish never touch it, and it can never end
    up in the WASM payload. Run it from the repo root; Program.cs documents the exact command line.
  -->
  <ItemGroup>
    <ProjectReference Include="..\..\Src\MaturinLogo.Core\MaturinLogo.Core.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>
