<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MaturinLogo.Core\MaturinLogo.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!--
      The architecture doc is copied next to the test assembly so CommandReferenceTests can read it.
      Linking it (rather than walking up out of bin/) keeps the test working whatever the working
      directory is, and PreserveNewest means the copy is never behind the file being edited.
    -->
    <Content Include="..\..\Docs\Architecture.md" Link="Architecture.md">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <!--
      The browser half is otherwise untestable from C#, but two of its constants are promises the
      interpreter makes to a child: the 16 colours SETPC can pick, and the shapes SHAPE selects.
      Linking the file lets a test compare them with Core's tables, which is what stops a colour
      added on one side from quietly differing on the other.
    -->
    <Content Include="..\MaturinLogo\wwwroot\js\interop.js" Link="interop.js">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>